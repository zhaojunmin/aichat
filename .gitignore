# Gradle / build output
.gradle/
.kotlin/
build/

# Local environment & secrets — never commit
local.properties

# Signing keystores (private keys)
*.jks
*.keystore

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/

# OS
.DS_Store
Thumbs.db

# Captured UI dumps / screenshots from development
*.png
# …except article figures (generated from SVG by docs/article/*/build_figures.py)
!docs/article/*/figures/*.png
*_dump.xml
# Stray xml dumps at repo root (uiautomator dumps etc.) — never source files
/*.xml
