# Perfetto config for profiling the bubble-tap path on a real phone
# (quality/scripts/perfetto-capture.sh). Collects, for the app process:
#   - the app's own trace sections (atrace, see diagnostics/Tracing.kt);
#   - CPU scheduling and frequency, to see core pausing / migration behind slow stages;
#   - callstack sampling at 1 kHz (user space only) — where the CPU time actually goes,
#     including inside native code (MNN LLM, bge encoder, ML Kit OCR).
# Callstack sampling needs traced_perf: adb shell setprop persist.traced_perf.enable 1
# linux.ftrace / linux.process_stats come from traced_probes, which some ROMs keep stopped
# (Honor: init.svc.traced_probes=stopped). perf-loop.sh therefore records the app's sections
# with atrace alongside, and perfetto_analyze.py joins the two on the shared boot clock.
# The release build is profileable (AndroidManifest <profileable android:shell="true"/>).

buffers { size_kb: 131072 fill_policy: RING_BUFFER }
buffers { size_kb: 8192 fill_policy: RING_BUFFER }

data_sources {
  config {
    name: "linux.ftrace"
    target_buffer: 0
    ftrace_config {
      ftrace_events: "sched/sched_switch"
      ftrace_events: "sched/sched_waking"
      ftrace_events: "power/cpu_frequency"
      ftrace_events: "power/cpu_idle"
      atrace_apps: "com.octos.aichat"
      buffer_size_kb: 16384
    }
  }
}

data_sources {
  config {
    name: "linux.process_stats"
    target_buffer: 1
    process_stats_config { scan_all_processes_on_start: true }
  }
}

data_sources {
  config {
    name: "linux.perf"
    target_buffer: 0
    perf_event_config {
      # BOOTTIME: the same clock atrace uses, so samples line up with the app's sections.
      timebase { frequency: 1000 timestamp_clock: PERF_CLOCK_BOOTTIME }
      callstack_sampling {
        scope { target_cmdline: "com.octos.aichat" }
        kernel_frames: false
      }
    }
  }
}

# Long enough for a tap loop; perf-loop.sh stops it early with --attach --stop. Detached
# sessions must stream to the output file.
duration_ms: 600000
write_into_file: true
file_write_period_ms: 2500
